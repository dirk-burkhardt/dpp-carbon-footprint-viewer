# Template for the settings of docker-compose.yml. Copy to .env and adapt.
# No credentials needed; maps (OpenStreetMap) and address search (Nominatim) work without keys.

# Port under which the user interface is available
UI_PORT=5001

# API
API_LOG_LEVEL=INFO
# Swagger under /api/docs
API_DOCS_ENABLED=true
# Loading AASX files from a URL (the API then requests third-party addresses)
API_EXTERNAL_SHELLS_ENABLED=true

# Uploading AAS(X) files in the user interface. The files are stored in repo/uploads and deleted after
# UPLOAD_TTL_HOURS hours and on every restart of the API. Files loaded from a link are discarded after the same
# time; the user interface shows both only in the browser in which they were added.
UPLOADS_ENABLED=true
# Maximum size of a file in MB (applies to API and nginx)
UPLOAD_MAX_MB=25
UPLOAD_TTL_HOURS=3

# Maps and address search, empty = OpenStreetMap / Nominatim. For many users enter your own servers.
# GEOCODING_URL=off disables the address search.
MAP_TILE_URL=
MAP_ATTRIBUTION=
GEOCODING_URL=
