# Vorlage für Einstellungen von docker-compose.yml. Als .env kopieren und anpassen.
# Keine Zugangsdaten nötig; Karten (OpenStreetMap) und Adresssuche (Nominatim) funktionieren ohne Schlüssel.

# Port, unter dem die Oberfläche erreichbar ist
UI_PORT=5001

# API
API_LOG_LEVEL=INFO
# Swagger unter /api/docs
API_DOCS_ENABLED=true
# Laden von AASX-Dateien über eine URL (die API ruft dann fremde Adressen auf)
API_EXTERNAL_SHELLS_ENABLED=true

# Hochladen von AAS(X)-Dateien in der Oberfläche. Die Dateien liegen in repo/uploads und werden nach
# UPLOAD_TTL_HOURS Stunden sowie bei jedem Neustart der API gelöscht. Über einen Link geladene Dateien werden nach
# derselben Zeit verworfen; die Oberfläche zeigt beides nur im Browser, in dem es hinzugefügt wurde.
UPLOADS_ENABLED=true
# Maximale Größe einer Datei in MB (gilt für API und nginx)
UPLOAD_MAX_MB=25
UPLOAD_TTL_HOURS=3

# Karten und Adresssuche, leer = OpenStreetMap / Nominatim. Für viele Nutzer eigene Server eintragen.
# GEOCODING_URL=off schaltet die Adresssuche ab.
MAP_TILE_URL=
MAP_ATTRIBUTION=
GEOCODING_URL=
