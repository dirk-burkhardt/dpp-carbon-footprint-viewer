# Endpoints of the API. Relative (/api/v4): in development Vite forwards /api to the API
# (target via API_PROXY_TARGET, default http://localhost:8080), in production the web server does this.
VITE_API_ASSET_ADMINISTRATION_SHELL_REGISTRY_URL=/api/v4
VITE_API_ASSET_ADMINISTRATION_SHELL_REPOSITORY_URL=/api/v4
VITE_API_SUBMODEL_REPOSITORY_URL=/api/v4

# Can be empty, then loading files from a URL and uploads are not possible
VITE_API_ASSET_ADDITIONALS_URL=/api/v4

# Whether /submodels/{submodelIdentifier} is used instead of /shells/{aasIdentifier}/submodels/{submodelIdentifier}
VITE_API_PREFER_SUBMODELS_REPOSITORY=0

# Map and geocoding (OpenStreetMap). For many users please enter your own tile and Nominatim servers,
# the public OSM servers are only meant for low load. An empty GEOCODING_URL disables the address search.
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_GEOCODING_URL=https://nominatim.openstreetmap.org
